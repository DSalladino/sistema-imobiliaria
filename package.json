{
  "name": "sistema-imobiliaria",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Sistema de gestão para imobiliária familiar: cadastros, contratos, cobranças, conciliação, repasses, documentos e relatórios.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/api.test.mjs tests/rules.test.mjs tests/ui.test.mjs tests/seed.test.mjs",
    "demo": "node src/demo.js",
    "demo:preparar": "node src/demo-preparar.js",
    "demo:servir": "node src/demo-server.js",
    "admin:reset": "node src/reset-admin.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.1",
    "qrcode": "^1.5.4",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "jsdom": "^25.0.1"
  }
}
