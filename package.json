{
  "name": "sistema-imobiliaria",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Sistema de gestão para imobiliária familiar: cadastros, contratos, cobranças, conciliação, repasses, documentos e relatórios.",
  "keywords": [
    "imobiliaria",
    "gestao",
    "nodejs",
    "sqlite",
    "financeiro",
    "cobrancas",
    "pix",
    "whatsapp",
    "comissoes",
    "contratos",
    "lgpd",
    "portfolio"
  ],
  "homepage": "https://github.com/DSalladino/sistema-imobiliaria#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DSalladino/sistema-imobiliaria.git"
  },
  "bugs": {
    "url": "https://github.com/DSalladino/sistema-imobiliaria/issues"
  },
  "author": "DSalladino",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prestart": "node scripts/verificar-ambiente.mjs",
    "start": "node src/server.js",
    "predev": "node scripts/verificar-ambiente.mjs",
    "dev": "node --watch src/server.js",
    "precheck": "node scripts/verificar-ambiente.mjs",
    "check": "node scripts/verificar-sintaxe.mjs",
    "deps:check": "node scripts/verificar-dependencias.mjs",
    "test": "node --test tests/api.test.mjs tests/rules.test.mjs tests/seguranca.test.mjs tests/features.test.mjs tests/ui.test.mjs tests/seed.test.mjs tests/relatorios.test.mjs tests/conciliacao.test.mjs tests/analytics.test.mjs tests/assistente.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/api.test.mjs tests/rules.test.mjs tests/seguranca.test.mjs tests/features.test.mjs tests/ui.test.mjs tests/seed.test.mjs tests/relatorios.test.mjs tests/conciliacao.test.mjs tests/analytics.test.mjs tests/assistente.test.mjs",
    "demo": "node src/demo.js",
    "demo:preparar": "node src/demo-preparar.js",
    "demo:servir": "node src/demo-server.js",
    "midia:capturar": "node scripts/capturar-telas.mjs",
    "midia:video": "node scripts/gravar-demo.mjs",
    "admin:reset": "node src/reset-admin.js",
    "predemo:preparar": "node scripts/verificar-ambiente.mjs",
    "predemo:servir": "node scripts/verificar-ambiente.mjs",
    "demo:estatico": "node scripts/gerar-demo-estatico.mjs"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.15.1",
    "qrcode": "^1.5.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "jsdom": "^25.0.1"
  },
  "overrides": {
    "readdir-glob": "^4.0.0",
    "minimatch": "^11.0.8"
  }
}
