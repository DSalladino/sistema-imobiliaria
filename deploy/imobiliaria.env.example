NODE_ENV=production
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=1

# Gere com: openssl rand -hex 32
# Guarde no gerenciador de senhas. Sem ele, os segredos de 2FA não são recuperáveis.
APP_SECRET=

# Senha inicial do administrador na primeira execução (opcional).
# Se ficar vazia, o sistema gera uma senha aleatória e mostra uma única vez no log.
ADMIN_SENHA=

# URL pública usada nos links de e-mail (obrigatória para recuperação de senha)
PUBLIC_URL=https://imobiliaria.exemplo.com

# Dados de demonstração (padrão: desligado em produção)
SEED_DEMO=0

# SMTP (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
